# Keep this file on the computer running the local API, not in the mobile app.
OPENAI_VERIFICATION_MODEL=gpt-6-luna
OPENAI_PLANNING_MODEL=gpt-6.1-sol
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_MEAL_MODEL=gpt-6-luna
OPENAI_PHOTO_MODEL=gpt-6.1-sol
OPENAI_REVIEW_MODEL=gpt-6.1-sol
CLAUDE_VERIFICATION_MODEL=claude-haiku-5-5
CLAUDE_PLANNING_MODEL=claude-sonnet-5-5
CLAUDE_CHAT_MODEL=claude-haiku-5-5
CLAUDE_MEAL_MODEL=claude-haiku-5-5
CLAUDE_PHOTO_MODEL=claude-sonnet-5-5
CLAUDE_REVIEW_MODEL=claude-sonnet-5-5
GEMINI_VERIFICATION_MODEL=gemma-4-26b-a4b-it
GEMINI_PLANNING_MODEL=gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_MEAL_MODEL=gemini-3.5-flash-lite
GEMINI_PHOTO_MODEL=gemini-3.8-flash
GEMINI_REVIEW_MODEL=gemini-3.8-flash
# Legacy OPENAI_MODEL/CLAUDE_MODEL override every task without a task-specific
# setting. Remove them to use the balanced defaults above.
# Optional server-side token metrics; never logs prompts, images, or API keys.
AI_USAGE_LOGGING=false
# Optional: set a long random value for deployments. If omitted, the local API
# creates server/data/gym-buddy.sqlite.ai-key and uses it to encrypt saved keys.
AI_KEY_ENCRYPTION_SECRET=
PORT=8787
HOST=0.0.0.0
DATABASE_PATH=server/data/gym-buddy.sqlite
# Comma-separated web origins allowed to call a deployed API. Localhost web
# previews are allowed automatically; native applications do not need CORS.
CORS_ORIGINS=
# App setting: configure in .env.local or the EAS build environment, then rebuild.
# EXPO_PUBLIC_API_URL=https://your-api.example.com
